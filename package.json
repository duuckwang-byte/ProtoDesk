{
  "name": "proto-viewer",
  "version": "1.2.0",
  "description": "原型预览工具 · 投融资录入工作流",
  "main": "main.js",
  "author": "local",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "start:react": "node -e \"process.env.PLAND_RENDERER='react';var p=require('child_process').spawn(require('electron'),['.'],{stdio:'inherit',env:process.env});p.on('exit',function(c){process.exit(c||0)})\"",
    "start:legacy": "node -e \"process.env.PLAND_RENDERER='legacy';var p=require('child_process').spawn(require('electron'),['.'],{stdio:'inherit',env:process.env});p.on('exit',function(c){process.exit(c||0)})\"",
    "dev:renderer": "node scripts/copy-export-assets.mjs && vite --config vite.config.ts",
    "build:renderer": "vite build --config vite.config.ts && node scripts/copy-export-assets.mjs",
    "build": "npm run build:renderer && electron-builder --win --x64",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "node tests/run-all.js",
    "test:all": "node tests/run-all.js",
    "test:ui": "node tests/run.js",
    "lint": "node tests/lint-guard.js",
    "lint:eslint": "eslint .",
    "format:check": "node -e \"var fs=require('fs');var p=JSON.parse(fs.readFileSync('.prettierrc.json','utf8'));console.log('prettier config ok singleQuote='+p.singleQuote+' printWidth='+p.printWidth)\""
  },
  "dependencies": {
    "acpx": "0.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "37.10.3",
    "electron-builder": "26.18.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^31.0.0",
    "lucide-react": "^1.72.0",
    "prettier": "^3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zustand": "^5.1.0"
  },
  "build": {
    "appId": "local.proto.viewer",
    "productName": "原型工具",
    "asar": true,
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "asarUnpack": [
      "node_modules/.bin/**",
      "node_modules/acpx/**",
      "node_modules/@agentclientprotocol/**",
      "node_modules/pi-acp/**"
    ],
    "files": [
      "main.js",
      "main/**",
      "preload.js",
      "app.css",
      "js/**",
      "!js/**/*.bak",
      "runtimes/**",
      "!runtimes/**/*.bak",
      "providers/**",
      "!providers/**/*.bak",
      "platform/**",
      "!platform/**/*.bak",
      "git/**",
      "!git/**/*.bak",
      "原型+文档.html",
      "toolPrompt.md",
      "design-specs/**",
      "!**/*.bak",
      "dist/renderer/**",
      "!**/node_modules/**/*.map",
      "!**/node_modules/**/*.md",
      "!**/node_modules/**/{test,tests,__tests__}/**",
      "!**/node_modules/**/*.{test,spec}.js",
      "!**/node_modules/zod/src/**",
      "!**/node_modules/bare-*/prebuilds/{android-*,darwin-*,ios-*,linux-*,win32-arm64}/**",
      "!**/node_modules/@esbuild/**",
      "!**/node_modules/lightningcss-win32-x64-msvc/**",
      "!**/node_modules/@tailwindcss/oxide-win32-x64-msvc/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "directories": {
      "output": "桌面端"
    }
  }
}
